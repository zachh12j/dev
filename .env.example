# --- Replicate (default provider) -------------------------------------------
# Create a token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Optional: override the model used for image-to-image edits.
# Defaults to black-forest-labs/flux-kontext-pro, which preserves composition
# while following the cat-transformation prompt. You can pin a specific
# version with the `owner/name:version` form.
# REPLICATE_MODEL=black-forest-labs/flux-kontext-pro

# --- Alternative providers --------------------------------------------------
# If you swap the provider in app/api/transform/route.ts, set its key here.
# OPENAI_API_KEY=
